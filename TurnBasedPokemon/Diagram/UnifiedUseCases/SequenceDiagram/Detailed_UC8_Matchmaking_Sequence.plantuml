@startuml UC8_Matchmaking_Sequence
participant Player
participant MainMenuScreen
participant IPvPService as PvPService
participant INetworkService as NetworkService
participant BattleHub
participant MatchmakingService
participant GameSession

Player -> MainMenuScreen: Select "PvP Battle"
activate MainMenuScreen

MainMenuScreen -> PvPService: CanAccessPvP()
activate PvPService
PvPService -> GameSession: Check Player.IsChampion
GameSession --> PvPService: IsChampion status
PvPService --> MainMenuScreen: bool (can access)
deactivate PvPService

alt Not Champion
  MainMenuScreen --> Player: "Must complete main storyline first"
else Is Champion
  MainMenuScreen -> PvPService: Connect()
  activate PvPService
  PvPService -> NetworkService: Connect()
  activate NetworkService
  NetworkService -> BattleHub: SignalR connection
  BattleHub --> NetworkService: Connected
  NetworkService --> PvPService: true
  deactivate NetworkService
  PvPService --> MainMenuScreen: true (connected)
  deactivate PvPService

  MainMenuScreen --> Player: "Searching for opponent... Press [Q] to cancel"

  MainMenuScreen -> PvPService: Subscribe OnMatchFound + OnMatchmakingRejected
  MainMenuScreen -> PvPService: FindMatch()
  activate PvPService
  PvPService -> NetworkService: FindMatch(username, pokemonTeam)
  activate NetworkService
  NetworkService -> BattleHub: FindMatch(username, serializedParty)
  activate BattleHub

  BattleHub -> MatchmakingService: JoinQueue(connectionId, username, party)
  activate MatchmakingService

  alt Another player in queue
    MatchmakingService -> MatchmakingService: Match two players
    MatchmakingService --> BattleHub: BattleRoom (roomId, player1, player2)

    BattleHub -> NetworkService: MatchFound(roomId, opponentName)
    deactivate BattleHub
    NetworkService -> PvPService: OnMatchFound event
    deactivate NetworkService
    PvPService -> MainMenuScreen: OnMatchFound(roomId, opponent)
    deactivate PvPService

    MainMenuScreen --> Player: "Match found! Opponent: {name}"
    MainMenuScreen -> MainMenuScreen: SwitchTo(ScreenType.PvP, roomId)

  else Same account detected
    MatchmakingService --> BattleHub: Rejection reason
    BattleHub -> NetworkService: MatchmakingRejected(reason)
    NetworkService -> PvPService: OnMatchmakingRejected event
    PvPService -> MainMenuScreen: OnMatchmakingRejected(reason)
    MainMenuScreen --> Player: Show rejection error

  else No match yet (waiting)
    MatchmakingService --> BattleHub: Keep waiting
    deactivate MatchmakingService

    loop Player waits
      alt Player presses [Q]
        Player -> MainMenuScreen: Press Q
        MainMenuScreen -> PvPService: CancelMatchmaking()
        PvPService -> NetworkService: CancelMatchmakingAsync()
        NetworkService -> BattleHub: Leave queue
        MainMenuScreen --> Player: "Matchmaking cancelled"
      end
    end
  end
end

deactivate MainMenuScreen
@enduml
