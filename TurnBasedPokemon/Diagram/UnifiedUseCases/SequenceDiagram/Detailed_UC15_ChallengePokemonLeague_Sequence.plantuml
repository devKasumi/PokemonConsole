@startuml UC15_ChallengePokemonLeague_Sequence
participant Player
participant StoryScreen
participant IStoryService as StoryService
participant IAuthenService as AuthenService
participant GameSession

Player -> StoryScreen: Select "Challenge Pokemon League"
activate StoryScreen

StoryScreen -> StoryScreen: Find Elite Four / Champion NPCs in location

loop for each boss NPC (Elite Four + Champion)
  StoryScreen -> StoryService: TryChallengePokemonLeague(boss)
  activate StoryService

  StoryService -> GameSession: Check Player.Badges count
  alt Has enough badges
    StoryService -> StoryService: Spawn boss team via PokemonSpawner
    StoryService --> StoryScreen: (true, message, bossTeam)
    deactivate StoryService

    StoryScreen --> Player: Show boss intro dialogue
    StoryScreen -> GameSession: SetupBattle(bossTeam, isTrainer=true)
    StoryScreen -> StoryScreen: SwitchTo(ScreenType.Battle)

    note over StoryScreen
      Battle executes via UC2 flow
    end note

    alt Battle Won
      StoryScreen --> Player: "Defeated {boss.Name}!"
      StoryScreen -> StoryScreen: Continue to next boss
    else Battle Lost
      StoryScreen --> Player: "Defeated by {boss.Name}..."
      break Return to story
    end

  else Not enough badges
    StoryService --> StoryScreen: (false, "Need all 8 badges", null)
    deactivate StoryService
    StoryScreen --> Player: Show requirement message
    break
  end
end

alt All bosses defeated (became Champion)
  StoryScreen -> AuthenService: SetChampion()
  activate AuthenService
  AuthenService -> GameSession: Player.IsChampion = true
  AuthenService -> AuthenService: SaveProgress()
  AuthenService --> StoryScreen: Champion status set
  deactivate AuthenService

  StoryScreen --> Player: "Congratulations! You are the new Champion!"
  StoryScreen --> Player: "PvP mode is now unlocked!"
end

deactivate StoryScreen
@enduml
