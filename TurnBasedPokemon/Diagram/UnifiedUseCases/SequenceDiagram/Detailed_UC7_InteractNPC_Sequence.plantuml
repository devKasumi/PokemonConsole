@startuml UC7_InteractNPC_Sequence
title UC7 - Interact with NPC (Sequence Diagram)

participant "Player" as Player
participant "StoryScreen" as Screen
participant "IStoryService\n(StoryService)" as StoryService
participant "PokemonSpawner" as Spawner
participant "GameSession" as GS
participant "ScreenManager" as SM

Player -> Screen: Approach NPC on map
activate Screen

Screen -> StoryService: GetCurrentLocation()
activate StoryService
StoryService --> Screen: LocationData (with NPC list)
deactivate StoryService

Screen --> Player: Display NPC names

Player -> Screen: Select NPC

Screen -> Screen: HandleTalk(npc)
Screen --> Player: Display npc.Dialogue lines

alt npc.Action == "StartBattle"
  note over Screen
    NPC wants to battle
    (e.g., Trainer on route)
  end note
  
  Screen -> StoryService: TryChallengeTrainer(npc)
  activate StoryService

  StoryService -> GS: Check Player.PokemonTeam
  activate GS
  GS --> StoryService: team alive status
  deactivate GS

  alt Team has alive Pokemon && trainer has Pokemon config
    StoryService -> Spawner: SpawnPokemon(pokemon config)
    activate Spawner
    Spawner --> StoryService: List<Pokemon> enemyTeam
    deactivate Spawner
    
    StoryService -> GS: Set CurrentEnemyTeam
    StoryService -> GS: Set IsTrainerBattle = true
    StoryService --> Screen: (true, message, enemyTeam)
  else No alive Pokemon or invalid trainer
    StoryService --> Screen: (false, error message, null)
    Screen --> Player: Display error
  end
  deactivate StoryService
  
  alt Battle initiated successfully
    Screen -> SM: SwitchScreen(ScreenType.BATTLE)
    note over SM
      Battle executes per UC2 flow
    end note
  end

else npc.Action == null (Normal NPC)
  note over Screen
    Regular NPC with dialogue only.
    Player reads dialogue and returns to map.
  end note
  Screen --> Player: Display dialogue complete
end

deactivate Screen
@enduml
