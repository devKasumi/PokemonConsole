@startuml UC1_Login_Sequence
participant Player
participant LoginScreen
participant IAuthenService as AuthenService
participant IUserRepository as UserRepository
participant GameSession

Player -> LoginScreen: Enter username & password
activate LoginScreen

LoginScreen -> AuthenService: Login(LoginRequest(username, password))
activate AuthenService

AuthenService -> UserRepository: GetByUsername(username)
activate UserRepository
UserRepository --> AuthenService: User? object
deactivate UserRepository

alt User exists
  AuthenService -> AuthenService: Compare password
  alt Password matches
    AuthenService -> GameSession: CurrentUser = user
    AuthenService --> LoginScreen: true (success)
    deactivate AuthenService
    LoginScreen --> Player: Switch to Main Menu
  else Password incorrect
    AuthenService --> LoginScreen: false (failed)
    deactivate AuthenService
    LoginScreen --> Player: Show error "Incorrect Password"
  end
else User not found
  AuthenService --> LoginScreen: false (failed)
  deactivate AuthenService
  LoginScreen --> Player: Show error "User not found"
end

deactivate LoginScreen
@enduml
