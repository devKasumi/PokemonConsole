@startuml UC15_ChallengePokemonLeague_Activity
title UC15 - Challenge Pokemon League (Activity Diagram)
start
:Player selects "Pokemon League" in StoryScreen;
:StoryScreen checks Player.Badges count;

if (Has all 8 badges?) then (yes)
  :StoryService retrieves Elite Four + Champion NPC list;
  
  repeat
    :StoryScreen calls StoryService.TryChallengePokemonLeague(boss);
    :PokemonSpawner generates boss team;
    :Set GameSession.CurrentEnemyTeam;
    :Set GameSession.IsTrainerBattle = true;
    :ScreenManager switches to BattleScreen;
    
    if (Player won?) then (yes)
      :ExpService processes victory rewards;
      :Continue to next Elite Four member;
    else (no)
      :Return to StoryScreen;
      stop
    endif
  repeat while (More Elite Four members)
  
  :Final battle: Player vs Champion;
  if (Player won?) then (yes)
    :AuthenService.SetChampion();
    :Display "You are the Champion!";
    :Player.IsChampion = true;
  else (no)
    :Return to StoryScreen;
  endif
  
else (no)
  :Display "You need all 8 badges!";
endif

stop
@enduml
