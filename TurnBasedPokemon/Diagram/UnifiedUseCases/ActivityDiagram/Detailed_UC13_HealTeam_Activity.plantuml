@startuml UC13_HealTeam_Activity
title UC13 - Heal Team (Activity Diagram)
start
:Player selects "Heal" at Pokemon Center in StoryScreen;
:StoryScreen calls StoryService.HealTeamAtCenter();

:StoryService iterates Player.PokemonTeam;
repeat
  :Restore Pokemon HP = MaxHP via Pokemon.Heal();
repeat while (More Pokemon in team)

:StoryService returns success message;
:StoryScreen displays "Your Pokemon are healed!";

stop
@enduml
