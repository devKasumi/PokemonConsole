@startuml PresentationLayerScreens
skinparam classAttributeIconSize 0
skinparam direction top to bottom
skinparam class {
  BackgroundColor #FFF9E6
  BorderColor #333333
  ArrowColor #333333
}

title Presentation Layer - UI Screens

interface IScreen {
  + Initialize(data: object?)
  + Update()
  + Shutdown()
}

class ScreenManager {
  + CurrentScreen: ScreenType
  - _screens: Dictionary<ScreenType, IScreen>
  - _isRunning: bool
  - _pendingData: object?
  + RegisterScreen(screenType: ScreenType, screen: IScreen)
  + ExitGame()
  + Run()
  + SwitchTo(screenType: ScreenType, data: object?)
}

class LoginScreen {
  - _screenManager: ScreenManager
  - _gameSession: GameSession
  - _authenService: IAuthenService
  + Initialize(data: object?)
  + Update()
  + Shutdown()
  - HandleLogin()
  - HandleRegister()
}

class MainMenuScreen {
  - _screenManager: ScreenManager
  - _gameSession: GameSession
  - _pvpService: IPvPService
  - _authenService: IAuthenService
  + Initialize(data: object?)
  + Update()
  - HandleStartNewGame()
  - HandleLoadGame()
  - HandlePvP()
  - HandleSaveGame()
  - HandleBackToLogin()
}

class BattleScreen {
  - _screenManager: ScreenManager
  - _gameSession: GameSession
  - _battleService: IBattleService
  + Initialize(data: object?)
  + Update()
  - HandleFightOption()
  - ExecuteBattleTurn(moveIndex: int)
  - HandleVictory()
  - CheckNextOpponent()
  - HandleOpenBag()
  - HandleSwitchPokemon()
  - HandleRun()
}

class StoryScreen {
  - _screenManager: ScreenManager
  - _gameSession: GameSession
  - _storyService: IStoryService
  - _authenService: IAuthenService
  + Initialize(data: object?)
  + Update()
  - DisplayNarrative()
  - RenderMenu()
  - ShowStarterMenu()
  - HandleTalk(npc: NpcData)
  - HandleWildArea()
  - HandleGymBattle()
  - HandlePokemonLeagueBattle()
}

class InventoryScreen {
  - _screenManager: ScreenManager
  - _gameSession: GameSession
  - _catchService: ICatchService
  - _healingService: IHealingService
  + Initialize(data: object?)
  + Update()
  + Shutdown()
  - OpenPocket(category: ItemCategory)
  - UseItem(item: Item): bool
}

class PvPScreen {
  - _sm: ScreenManager
  - _network: INetworkService
  - _session: GameSession
  - _roomId: string
  - _lastResult: PvPTurnResult? <<volatile>>
  - _waitingForResult: bool <<volatile>>
  + Initialize(data: object?)
  + Update()
  + Shutdown()
  - HandleTurnResult(result: PvPTurnResult)
  - RenderBattleScene(result: PvPTurnResult)
  - ShowMoveMenu(myActive: PvPMonState)
}

' Relationships
LoginScreen ..|> IScreen
MainMenuScreen ..|> IScreen
BattleScreen ..|> IScreen
StoryScreen ..|> IScreen
InventoryScreen ..|> IScreen
PvPScreen ..|> IScreen

ScreenManager --> IScreen : manages
ScreenManager --> ScreenType : uses

LoginScreen --> IAuthenService
LoginScreen --> GameSession

MainMenuScreen --> IPvPService
MainMenuScreen --> IAuthenService
MainMenuScreen --> GameSession

BattleScreen --> IBattleService
BattleScreen --> GameSession

StoryScreen --> IStoryService
StoryScreen --> IAuthenService
StoryScreen --> GameSession

InventoryScreen --> ICatchService
InventoryScreen --> IHealingService
InventoryScreen --> GameSession

PvPScreen --> INetworkService
PvPScreen --> GameSession

@enduml
