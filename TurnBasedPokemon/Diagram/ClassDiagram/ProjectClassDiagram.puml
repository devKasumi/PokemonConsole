@startuml PokemonGameArchitecture
skinparam classAttributeIconSize 0
skinparam direction top to bottom
skinparam class {
  BackgroundColor #FFF9E6
  BorderColor #333333
  ArrowColor #333333
}
skinparam arrow {
  Color #333333
}
skinparam package {
  BackgroundColor #FFFACD
  BorderColor #333333
}

title Pokemon Game - High Level Architecture

package "Presentation Layer" {
  class LoginScreen
  class MainMenuScreen
  class BattleScreen
  class StoryScreen
  class InventoryScreen
  class PvPScreen
}

package "Application Layer" {
  class BattleService
  class StoryService
  class ExpService
  class HealingService
  class CatchService
  class AuthenService
  class FileService
  class WorldGenerationService
  class MatchmakingService
}

package "Domain Layer" {
  class GameSession
  class User
  class Player
  class Pokemon
  class PokemonSpecies
  class PokemonMove
  class Item
  class Inventory
}

package "Infrastructure Layer" {
  class UserRepository
  class PokedexRepository
  class ItemRepository
  class PokemonSpawner
  class ItemSpawner
}

Presentation --> Application: uses
Application --> Domain: manipulates
Application --> Infrastructure: queries
Domain --> Infrastructure: persists
@enduml