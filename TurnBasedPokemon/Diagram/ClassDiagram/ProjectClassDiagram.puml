@startuml PokemonGameArchitecture
skinparam classAttributeIconSize 0
skinparam direction top to bottom
skinparam class {
  BackgroundColor #FFF9E6
  BorderColor #333333
  ArrowColor #333333
}
skinparam arrow {
  Color #333333
}
skinparam package {
  BackgroundColor #FFFACD
  BorderColor #333333
}

title Pokemon Game - High Level Architecture

package "Presentation Layer" {
  class ScreenManager
  class LoginScreen
  class MainMenuScreen
  class BattleScreen
  class StoryScreen
  class InventoryScreen
  class PvPScreen
}

package "Application Layer" {
  interface IBattleService
  interface IStoryService
  interface IExpService
  interface IHealingService
  interface ICatchService
  interface IAuthenService
  interface IPvPService
  interface INetworkService
  interface IWorldGenerationService
  interface IFileService
  class BattleService
  class StoryService
  class ExpService
  class HealingService
  class CatchService
  class AuthenService
  class PvPService
  class WorldGenerationService
  class PokemonSpawner
  class ItemSpawner
}

package "Domain Layer" {
  class GameSession
  class User
  class Player
  class Pokemon
  class PokemonSpecies
  class Item
  class Trainer
  class CatchFormula
}

package "Infrastructure Layer" {
  class UserRepository
  class PokedexRepository
  class ItemRepository
  class FileService
  class NetworkService
  class MySqlUserRepository
  class MySqlPokedexRepository
  class MySqlItemRepository
  class MySqlStoryService
  class DatabaseSeeder
}

package "Pokemon.Shared" {
  class DamageCalculator
  class TypeChart
  class PvPTurnResult
  class BattleActionRequest
}

package "PokemonServer" {
  class BattleHub
  class MatchmakingService
  class PvPManager
  class BattleRoom
}

Presentation --> Application: uses interfaces
Application --> Domain: manipulates entities
Infrastructure --> Application: implements interfaces
Infrastructure ..> Domain: persists entities

@enduml