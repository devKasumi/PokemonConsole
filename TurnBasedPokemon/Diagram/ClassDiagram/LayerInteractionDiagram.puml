@startuml LayerInteractionDiagram
skinparam classAttributeIconSize 0
skinparam direction top to bottom
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFF9E6
  BorderColor #333333
  ArrowColor #333333
}
skinparam arrow {
  Color #333333
}
skinparam package {
  BackgroundColor #FFFACD
  BorderColor #333333
}

title Pokemon Game - Layer Interaction Diagram

package "Presentation Layer" {
  class LoginScreen
  class MainMenuScreen
  class BattleScreen
  class StoryScreen
  class InventoryScreen
  class PvPScreen
  class ScreenManager
}

package "Application Layer" {
  class BattleService
  class StoryService
  class ExpService
  class HealingService
  class CatchService
  class AuthenService
  class WorldGenerationService
  class PvPService
  class PokemonSpawner
  class ItemSpawner
}

package "Domain Layer" {
  class GameSession
  class User
  class Player
  class Pokemon
  class PokemonSpecies
  class Item
}

package "Infrastructure Layer" {
  class UserRepository
  class PokedexRepository
  class ItemRepository
  class FileService
  class NetworkService
}

' Main layer interactions
Presentation --> Application : uses interfaces
Application --> Domain : manipulates entities
Infrastructure ..|> Application : implements interfaces

' Key specific interactions
LoginScreen --> AuthenService : IAuthenService
MainMenuScreen --> PvPService : IPvPService
MainMenuScreen --> AuthenService : IAuthenService (save/load)

BattleScreen --> BattleService : IBattleService
BattleService --> GameSession : battle state
BattleService --> ExpService : IExpService

StoryScreen --> StoryService : IStoryService
StoryScreen --> AuthenService : IAuthenService (champion)
StoryService --> GameSession : story state
StoryService --> PokemonSpawner : spawn pokemon
StoryService --> ItemSpawner : spawn items

InventoryScreen --> CatchService : ICatchService
InventoryScreen --> HealingService : IHealingService

PvPScreen --> NetworkService : INetworkService
PvPService --> NetworkService : INetworkService
PvPService --> GameSession : check champion

AuthenService --> UserRepository : IUserRepository
AuthenService --> GameSession : session state

WorldGenerationService --> PokemonSpawner : spawn
WorldGenerationService --> ItemSpawner : spawn
PokemonSpawner --> PokedexRepository : IPokedexRepository
ItemSpawner --> ItemRepository : IItemRepository

UserRepository --> FileService : IFileService

@enduml</content>
