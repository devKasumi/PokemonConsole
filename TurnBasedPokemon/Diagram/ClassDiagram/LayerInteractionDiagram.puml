@startuml LayerInteractionDiagram
skinparam classAttributeIconSize 0
top to bottom direction
skinparam nodesep 60
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFF9E6
  BorderColor #333333
  ArrowColor #333333
}
skinparam arrow {
  Color #333333
}
skinparam package {
  BackgroundColor #FFFACD
  BorderColor #333333
  padding 15
}

title Pokemon Game - Layer Interaction Diagram

package "Presentation Layer" {
  class InventoryScreen
  class LoginScreen
  class BattleScreen
  class StoryScreen
  class PvPScreen
  class MainMenuScreen
  class ScreenManager
}

package "Application Layer" {
  class CatchService
  class HealingService
  class BattleService
  class StoryService
  class PvPService
  class AuthenService
  class WorldGenerationService
  class ExpService
  class PokemonSpawner
  class ItemSpawner
}

package "Domain Layer" {
  class GameSession
  class User
  class Player
  class Pokemon
  class PokemonSpecies
  class Item
}

package "Infrastructure Layer" {
  class NetworkService
  class UserRepository
  class PokedexRepository
  class ItemRepository
  class FileService
}

' ===== Layer ordering =====
Presentation -[hidden]down- Application
Application -[hidden]down- Domain
Domain -[hidden]down- Infrastructure

@enduml</content>
