@startuml InfrastructureLayerRepositories
skinparam classAttributeIconSize 0
skinparam direction top to bottom
skinparam class {
  BackgroundColor #FFF9E6
  BorderColor #333333
  ArrowColor #333333
}

title Infrastructure Layer - Repositories, Persistence & Network

' ===== User Repositories =====
interface IUserRepository <<Application>> {
  + GetAll(): List<User>
  + GetByUsername(username: string): User?
  + Save(user: User)
}

class UserRepository <<Json>> {
  - _filePath: string = "users.json"
  - _fileService: IFileService
  + GetAll(): List<User>
  + GetByUsername(username: string): User?
  + Save(user: User)
}

class MySqlUserRepository <<MySql>> {
  - _connection: string
  - _pokedex: IPokedexRepository
  + GetAll(): List<User>
  + GetByUsername(username: string): User?
  + Save(user: User)
}

' ===== Pokedex Repositories =====
interface IPokedexRepository <<Application>> {
  + GetSpecies(name: string): PokemonSpecies?
  + GetSpeciesById(id: int): PokemonSpecies?
}

class PokedexRepository <<Json>> {
  - _filePath: string = "pokemon.json"
  - _fileService: IFileService
  - _cache: Dictionary<string, PokemonSpecies>
  + GetSpecies(name: string): PokemonSpecies?
  + GetSpeciesById(id: int): PokemonSpecies?
}

class MySqlPokedexRepository <<MySql>> {
  - _connectionString: string
  - _cache: Dictionary<string, PokemonSpecies>
  + GetSpecies(name: string): PokemonSpecies?
  + GetSpeciesById(id: int): PokemonSpecies?
}

' ===== Item Repositories =====
interface IItemRepository <<Application>> {
  + GetItemByName(name: string): Item?
  + GetItemById(id: int): Item?
  + GetAllItems(): List<Item>
}

class ItemRepository <<Json>> {
  - _filePath: string = "item.json"
  - _fileService: IFileService
  - _cache: Dictionary<string, Item>
  + GetItemByName(name: string): Item?
  + GetItemById(id: int): Item?
  + GetAllItems(): List<Item>
}

class MySqlItemRepository <<MySql>> {
  - _connection: string
  - _cache: Dictionary<string, Item>
  + GetItemByName(name: string): Item?
  + GetItemById(id: int): Item?
  + GetAllItems(): List<Item>
}

' ===== File Service =====
class FileService {
  - _options: JsonSerializerOptions
  + Save<T>(fileName: string, data: T)
  + Load<T>(fileName: string): T?
  + Exists(fileName: string): bool
  + Delete(fileName: string)
}

' ===== Network Service =====
class NetworkService {
  - _connection: HubConnection
  + OnMatchFound: event Action<string, string>
  + OnWaiting: event Action
  + OnMatchmakingRejected: event Action<string>
  + OnTurnResultReceived: event Action<PvPTurnResult>
  + LastTurnResult: PvPTurnResult?
  + Connect(): Task<bool>
  + FindMatch(username: string, party: List<Pokemon>): Task
  + SubmitMoveAsync(roomId: string, playerName: string, moveIndex: int, attackerPokemon: Pokemon): Task
  + CancelMatchmakingAsync(): Task
}

' ===== MySql Story Service =====
class MySqlStoryService {
  - _gameSession: GameSession
  - _pokemonSpawner: PokemonSpawner
  - _itemSpawner: ItemSpawner
  - _dbConnection: string
}

' ===== Database Seeder =====
class DatabaseSeeder {
  - _connection: string
  - _userRepo: MySqlUserRepository
  + SeedAll()
  - SeedItems()
  - SeedPokedex()
  - SeedStory()
  - SeedUsers()
}

' Relationships
UserRepository ..|> IUserRepository
MySqlUserRepository ..|> IUserRepository
UserRepository --> IFileService

PokedexRepository ..|> IPokedexRepository
MySqlPokedexRepository ..|> IPokedexRepository
PokedexRepository --> IFileService

ItemRepository ..|> IItemRepository
MySqlItemRepository ..|> IItemRepository
ItemRepository --> IFileService

FileService ..|> IFileService

NetworkService ..|> INetworkService

MySqlStoryService ..|> IStoryService

DatabaseSeeder --> MySqlUserRepository

@enduml
