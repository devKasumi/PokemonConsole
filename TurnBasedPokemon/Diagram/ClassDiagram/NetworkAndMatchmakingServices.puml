@startuml NetworkAndMatchmakingServices
skinparam classAttributeIconSize 0
skinparam direction top to bottom
skinparam class {
  BackgroundColor #FFF9E6
  BorderColor #333333
  ArrowColor #333333
}

title Network, PvP & Matchmaking Services

' ===== Application Layer Interfaces =====
interface INetworkService <<Application>> {
  + OnMatchFound: event Action<string, string>
  + OnWaiting: event Action
  + OnMatchmakingRejected: event Action<string>
  + OnTurnResultReceived: event Action<PvPTurnResult>
  + LastTurnResult: PvPTurnResult?
  + Connect(): Task<bool>
  + FindMatch(username: string, party: List<Pokemon>): Task
  + SubmitMoveAsync(roomId: string, playerName: string, moveIndex: int, attackerPokemon: Pokemon): Task
  + CancelMatchmakingAsync(): Task
}

interface IPvPService <<Application>> {
  + CanAccessPvP(): bool
  + Connect(): bool
  + FindMatch()
  + CancelMatchmaking()
  + OnMatchFound: event Action<string, string>
  + OnMatchmakingRejected: event Action<string>
}

class PvPService <<Application>> {
  - _gameSession: GameSession
  - _networkService: INetworkService
  + CanAccessPvP(): bool
  + Connect(): bool
  + FindMatch()
  + CancelMatchmaking()
  + OnMatchFound: event Action<string, string>
  + OnMatchmakingRejected: event Action<string>
}

' ===== Infrastructure Layer =====
class NetworkService <<Infrastructure>> {
  - _connection: HubConnection
  + OnMatchFound: event Action<string, string>
  + OnWaiting: event Action
  + OnMatchmakingRejected: event Action<string>
  + OnTurnResultReceived: event Action<PvPTurnResult>
  + LastTurnResult: PvPTurnResult?
  + Connect(): Task<bool>
  + FindMatch(username: string, party: List<Pokemon>): Task
  + SubmitMoveAsync(roomId: string, playerName: string, moveIndex: int, attackerPokemon: Pokemon): Task
  + CancelMatchmakingAsync(): Task
}

' ===== Server Side (PokemonServer) =====
class BattleHub <<Server>> {
  + FindMatch(username: string, serializedParty: string)
  + SubmitMove(request: BattleActionRequest)
}

class MatchmakingService <<Server>> {
  - _waitingPlayers: List<WaitingPlayer>
  + JoinQueue(connectionId: string, username: string, party: List<Pokemon>): BattleRoom?
  + GetRoom(roomId: string): BattleRoom?
}

class BattleRoom <<Server>> {
  + RoomId: string
  + Player1: WaitingPlayer
  + Player2: WaitingPlayer
  + IsActive: bool
}

class PvPManager <<Server>> {
  + InitializeBattle(roomId: string, player1: string, party1: List<Pokemon>, player2: string, party2: List<Pokemon>)
  + RegisterMove(request: BattleActionRequest)
  + IsRoomReady(roomId: string): bool
  + ProcessTurn(roomId: string): PvPTurnResult
  + SwapPokemon(roomId: string, playerName: string, newIndex: int)
  + GetBattleState(roomId: string): PvPBattleState?
}

class WaitingPlayer <<Server>> {
  + ConnectionId: string
  + Username: string
  + Party: List<Pokemon>
}

' ===== Shared DTOs (Pokemon.Shared) =====
class PvPTurnResult <<Shared>> {
  + PlayerState: PvPMonState
  + OpponentState: PvPMonState
  + Logs: List<string>
  + Winner: string?
}

class PvPMonState <<Shared>> {
  + Name: string
  + CurrentHp: int
  + MaxHp: int
  + Level: int
  + Moves: List<PokemonMove>
}

class BattleActionRequest <<Shared>> {
  + RoomId: string
  + PlayerName: string
  + MoveIndex: int
  + AttackerPokemon: Pokemon
}

' ===== Relationships =====
PvPService ..|> IPvPService
PvPService --> INetworkService
PvPService --> GameSession

NetworkService ..|> INetworkService
NetworkService ..> BattleHub : SignalR

BattleHub --> MatchmakingService
BattleHub --> PvPManager
MatchmakingService --> BattleRoom
BattleRoom --> WaitingPlayer
PvPManager --> PvPTurnResult
PvPManager --> BattleActionRequest

@enduml</content>
