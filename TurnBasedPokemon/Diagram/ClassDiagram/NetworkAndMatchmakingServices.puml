@startuml NetworkAndMatchmakingServices
skinparam classAttributeIconSize 0
skinparam direction top to bottom
skinparam class {
  BackgroundColor #FFF9E6
  BorderColor #333333
  ArrowColor #333333
}

title Application Layer - Network and Matchmaking Services


class NetworkService {
  + FindMatch(username: string)
  + SubmitMoveAsync(roomId: string, playerName: string, moveIndex: int, attackerPokemon: Pokemon)
  + OnMatchFound: event
  + OnTurnResultReceived: event
  + OnWaiting: event
}

class MatchmakingService {
  + JoinQueue(connectionId: string, username: string): BattleRoom?
  + GetRoom(roomId: string): BattleRoom?
}

class BattleRoom {
  + RoomId: string
  + Player1: WaitingPlayer
  + Player2: WaitingPlayer
  + IsActive: bool
}

class PvPManager {
  + InitializeBattle(roomId: string, player1: string, party1: List<Pokemon>, player2: string, party2: List<Pokemon>)
  + RegisterMove(request: BattleActionRequest)
  + IsRoomReady(roomId: string): bool
  + ProcessTurn(roomId: string): PvPTurnResult
  + SwapPokemon(roomId: string, playerName: string, newIndex: int)
  + GetBattleState(roomId: string): PvPBattleState?
}

class WaitingPlayer {
  + ConnectionId: string
  + Username: string
}


' Relationships
NetworkService ..> "SignalR" BattleHub : network
BattleHub --> MatchmakingService
BattleHub --> PvPManager
MatchmakingService --> BattleRoom
BattleRoom --> WaitingPlayer
PvPManager --> PvPBattleState
PvPManager --> BattleActionRequest
PvPManager --> PvPTurnResult

@enduml</content>
