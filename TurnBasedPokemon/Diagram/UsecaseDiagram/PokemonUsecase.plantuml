@startuml Pokemon Turn-Based System
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 130
left to right direction

' --- Actors ---
actor "Trainer (Player)" as T
actor "System Admin" as A
actor "Database / Server" as Sys

rectangle "Pokemon Turn-Based System" {
    
    package "Phase 1 & 2: Core PvE & Mechanics" {
        usecase "UC_1: Login / Auth" as UC1
        usecase "UC_2: Battle Wild Pokemon" as UC2
        usecase "UC_3: Catch Pokemon" as UC3
        usecase "UC_4: Use Items (Potion/Ball)" as UC4
        usecase "UC_5: Manage Pokemon Team" as UC5
        
        ' Relationships
        UC2 <.. UC3 : <<extend>>
        UC2 <.. UC4 : <<extend>>
    }

    package "Phase 3: Story Mode" {
        usecase "UC_6: Explore Story" as UC6
        usecase "UC_7: Interact with NPCs" as UC7
    }

    package "Phase 5: PvP Online" {
        usecase "UC_8: Join Matchmaking" as UC8
        usecase "UC_9: Battle Other Players" as UC9
        
        ' Sequence connection
        UC8 ..> UC9 : <<invoke>>
    }

    package "Phase 6: Persistence & Admin" {
        usecase "UC_10: Save/Load Game Data" as UC10
        usecase "UC_11: View Match History" as UC11
        usecase "UC_12: Manage Game Content" as Manage
    }

    T -- UC1
    T -- UC2
    T -- UC5
    T -- UC6
    T -- UC7
    T -- UC8
    T -- UC9

    A -- UC1
    A -- UC11
    A -- Manage

    ' --- System Interactions ---
    UC1 ..> UC10 : <<include>>
    UC10 -- Sys
    UC11 -- Sys
    Manage -- Sys

    "Phase 1 & 2: Core PvE & Mechanics" -[hidden]d-> "Phase 3: Story Mode"
    "Phase 3: Story Mode" -[hidden]d-> "Phase 5: PvP Online"
    "Phase 5: PvP Online" -[hidden]d-> "Phase 6: Persistence & Admin"
}
@enduml