@startuml UC1_Login_UseCase
title UC1 - Login / Authentication (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor Player

rectangle "Login System" {
  (Launch Game)
  (Display LoginScreen)
  (Enter Username & Password)
  (AuthenService validates credentials)
  (Check user in UserRepository)
  (Verify password)
  (Load Player profile)
  (Initialize GameSession)
  (Switch to MainMenuScreen)
  (Display error message)
}

Player --> (Launch Game)
(Launch Game) --> (Display LoginScreen)
(Display LoginScreen) --> (Enter Username & Password)
(Enter Username & Password) --> (AuthenService validates credentials)
(AuthenService validates credentials) --> (Check user in UserRepository) : <<include>>
(AuthenService validates credentials) --> (Verify password) : <<include>>
(Check user in UserRepository) --> (Load Player profile)
(Verify password) --> (Load Player profile)
(Load Player profile) --> (Initialize GameSession)
(Initialize GameSession) --> (Switch to MainMenuScreen)
(Switch to MainMenuScreen) --> Player
(AuthenService validates credentials) --> (Display error message) : <<extend>>
(Display error message) --> Player

@enduml
