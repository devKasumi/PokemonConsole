@startuml UC3_CatchPokemon_UseCase
skinparam linetype ortho
left to right direction

actor Player

rectangle "Pokemon Catch System" {
  (During Battle with Wild Pokemon)
  (Select Catch Option)
  (Available Pokeballs?)
  (Select Pokeball Type)
  (Throw Pokeball)
  (Reduce Pokemon HP)
  (Calculate Catch Rate)
  (Shake Check)
  (Caught!)
  (Escaped)
  (Add to Team/Box)
  (Gain Pokedex Entry)
  (Ball Used Up)
  (Continue Battle)
  (Cannot Catch)
}

Player --> (During Battle with Wild Pokemon)
(During Battle with Wild Pokemon) --> (Select Catch Option)
(Select Catch Option) --> (Available Pokeballs?)

(Available Pokeballs?) --> (Select Pokeball Type) : has balls
(Available Pokeballs?) --> (Cannot Catch) : no balls

(Select Pokeball Type) --> (Throw Pokeball)
(Throw Pokeball) --> (Reduce Pokemon HP) : <<prerequisite>>
(Throw Pokeball) --> (Calculate Catch Rate) : <<include>>
(Calculate Catch Rate) --> (Shake Check)
(Shake Check) --> (Caught!) : <<success>>
(Shake Check) --> (Escaped) : <<fail>>

(Caught!) --> (Add to Team/Box)
(Caught!) --> (Gain Pokedex Entry)
(Add to Team/Box) --> Player

(Escaped) --> (Ball Used Up)
(Ball Used Up) --> (Continue Battle)
(Cannot Catch) --> (Continue Battle)
(Continue Battle) --> Player

@enduml
