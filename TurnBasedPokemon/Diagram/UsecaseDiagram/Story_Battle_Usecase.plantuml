@startuml Pokemon Story & Battle System
left to right direction

actor Trainer
actor System

rectangle "Pokemon Story & Battle System" {

  Trainer --> (Login)
  Trainer --> (Explore Location)
  Trainer --> (Battle Pokemon)

  (Login) --> (Authenticate User)

  System --> (Auto-save Progress)

  (Battle Pokemon) --> (Calculate Damage)
  (Battle Pokemon) --> (Calculate EXP)
}

@enduml