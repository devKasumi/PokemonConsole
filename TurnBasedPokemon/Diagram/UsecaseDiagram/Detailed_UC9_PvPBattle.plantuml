@startuml UC9_PvPBattle_UseCase
title UC9 - PvP Battle (Use Case Diagram)
skinparam linetype ortho
left to right direction

together {
  actor Player1
  actor Player2
}

rectangle "PvP Battle System" {
  (PvPScreen initialized)
  (PvPManager initializes BattleRoom)
  (BattleHub sends StartBattle)
  (Display both teams)
  (Player selects move)
  (NetworkService sends SubmitMove)
  (BattleHub forwards to PvPManager)
  (Both moves received?)
  (PvPManager calculates DamageResult)
  (Timeout - use default action)
  (BattleHub sends TurnResult)
  (PvPScreen updates UI)
  (Check if Pokemon fainted)
  (Switch Pokemon via NetworkService)
  (PvPManager declares winner)
  (BattleHub sends BattleEnded)
  (Display result)
  (Return to MainMenu)
}

Player1 --> (PvPScreen initialized)
Player2 --> (PvPScreen initialized)

(PvPScreen initialized) --> (PvPManager initializes BattleRoom)
(PvPManager initializes BattleRoom) --> (BattleHub sends StartBattle)
(BattleHub sends StartBattle) --> (Display both teams)

Player1 --> (Player selects move)
Player2 --> (Player selects move)

(Player selects move) --> (NetworkService sends SubmitMove)
(NetworkService sends SubmitMove) --> (BattleHub forwards to PvPManager)
(BattleHub forwards to PvPManager) --> (Both moves received?)

(Both moves received?) --> (PvPManager calculates DamageResult) : both ready
(Both moves received?) --> (Timeout - use default action) : timeout
(Timeout - use default action) --> (PvPManager calculates DamageResult)

(PvPManager calculates DamageResult) --> (BattleHub sends TurnResult)
(BattleHub sends TurnResult) --> (PvPScreen updates UI)
(PvPScreen updates UI) --> (Check if Pokemon fainted)

(Check if Pokemon fainted) --> (Switch Pokemon via NetworkService) : fainted, has more
(Check if Pokemon fainted) --> (PvPManager declares winner) : no more Pokemon
(Check if Pokemon fainted) --> Player1 : battle continues

(PvPManager declares winner) --> (BattleHub sends BattleEnded)
(BattleHub sends BattleEnded) --> (Display result)
(Display result) --> (Return to MainMenu)
(Return to MainMenu) --> Player1
(Return to MainMenu) --> Player2

@enduml
