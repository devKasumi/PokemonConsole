@startuml UC18_Register_UseCase
title UC18 - Register (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor NewPlayer

rectangle "Account Registration System" {
  (Open game)
  (Select Register)
  (Enter username)
  (Enter password)
  (Validate input)
  (Handle username taken)
  (Save to users.json)
  (Create Player profile)
  (Initialize starter selection)
  (Account created)
  (Enter Story Screen)
}

NewPlayer --> (Open game)
(Open game) --> (Select Register)
(Select Register) --> (Enter username)
(Enter username) --> (Enter password)
(Enter password) --> (Validate input)

(Validate input) --> (Handle username taken) : username taken
(Validate input) --> (Save to users.json) : valid input
(Handle username taken) --> (Enter username)
(Save to users.json) --> (Create Player profile)
(Create Player profile) --> (Initialize starter selection)
(Initialize starter selection) --> (Account created)
(Account created) --> (Enter Story Screen)
(Enter Story Screen) --> NewPlayer

@enduml
