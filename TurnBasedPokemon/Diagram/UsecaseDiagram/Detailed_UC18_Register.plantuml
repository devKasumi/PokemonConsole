@startuml UC18_Register_UseCase
title UC18 - Register (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor NewPlayer

rectangle "Account Registration System" {
  (Open game)
  (Select Register)
  (Enter username)
  (Enter password)
  (Validate input)
  (Handle username taken)
  (AuthenService hashes password)
  (Save new User to users.json)
  (Registration successful)
  (Return to Login menu)
}

NewPlayer --> (Open game)
(Open game) --> (Select Register)
(Select Register) --> (Enter username)
(Enter username) --> (Enter password)
(Enter password) --> (Validate input)

(Validate input) --> (Handle username taken) : username taken
(Validate input) --> (AuthenService hashes password) : valid input
(Handle username taken) --> (Enter username)
(AuthenService hashes password) --> (Save new User to users.json)
(Save new User to users.json) --> (Registration successful)
(Registration successful) --> (Return to Login menu)
(Return to Login menu) --> NewPlayer

@enduml
