@startuml UC13_HealTeam_UseCase
title UC13 - Heal Team at Pokemon Center (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor Player

rectangle "Pokemon Center Healing System" {
  (Select Heal in StoryScreen)
  (StoryService.HealTeamAtCenter)
  (Iterate Player.PokemonTeam)
  (Pokemon.Heal restores HP)
  (Display healing message)
  (Return to StoryScreen)
}

Player --> (Select Heal in StoryScreen)
(Select Heal in StoryScreen) --> (StoryService.HealTeamAtCenter)
(StoryService.HealTeamAtCenter) --> (Iterate Player.PokemonTeam) : <<include>>
(Iterate Player.PokemonTeam) --> (Pokemon.Heal restores HP)
(Pokemon.Heal restores HP) --> (Display healing message)
(Display healing message) --> (Return to StoryScreen)
(Return to StoryScreen) --> Player

@enduml
