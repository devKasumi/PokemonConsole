@startuml UC4_UseItems_UseCase
title UC4 - Use Items (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor Player

rectangle "Item System" {
  (Open InventoryScreen)
  (View Player.Inventory)
  (Select item)
  (Item type check)
  (HealingItem selected)
  (CaptureItem selected)
  (Choose target Pokemon)
  (HealingService applies effect)
  (Consume item)
  (CatchService.ExecuteCapture)
  (Cannot use outside battle)
}

Player --> (Open InventoryScreen)
(Open InventoryScreen) --> (View Player.Inventory)
(View Player.Inventory) --> (Select item)
(Select item) --> (Item type check)

(Item type check) --> (HealingItem selected) : HealingItem
(Item type check) --> (CaptureItem selected) : CaptureItem

(HealingItem selected) --> (Choose target Pokemon)
(Choose target Pokemon) --> (HealingService applies effect)
(HealingService applies effect) --> (Consume item)
(Consume item) --> Player

(CaptureItem selected) --> (CatchService.ExecuteCapture) : in battle
(CaptureItem selected) --> (Cannot use outside battle) : not in battle
(CatchService.ExecuteCapture) --> Player
(Cannot use outside battle) --> Player

@enduml
