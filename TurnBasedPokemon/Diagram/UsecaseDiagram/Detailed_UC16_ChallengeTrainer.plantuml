@startuml UC16_ChallengeTrainer_UseCase
title UC16 - Challenge Trainer (Use Case Diagram)
note "**Under Development**\nTrainer challenge exists via\nStoryService.TryChallengeTrainer()\nbut no dedicated screen yet." as N1
skinparam linetype ortho
left to right direction

actor Player

rectangle "Trainer Battle System" {
  (Encounter Trainer NPC in StoryScreen)
  (StoryScreen.HandleTalk displays dialogue)
  (npc.Action == StartBattle)
  (StoryService.TryChallengeTrainer)
  (Check team alive)
  (PokemonSpawner generates trainer team)
  (Set GameSession.CurrentEnemyTeam)
  (Switch to BattleScreen)
  (Battle result)
  (Player won)
  (Player lost)
  (ExpService processes rewards)
  (Return to StoryScreen)
}

Player --> (Encounter Trainer NPC in StoryScreen)
(Encounter Trainer NPC in StoryScreen) --> (StoryScreen.HandleTalk displays dialogue)
(StoryScreen.HandleTalk displays dialogue) --> (npc.Action == StartBattle)
(npc.Action == StartBattle) --> (StoryService.TryChallengeTrainer)
(StoryService.TryChallengeTrainer) --> (Check team alive)
(Check team alive) --> (PokemonSpawner generates trainer team) : alive
(PokemonSpawner generates trainer team) --> (Set GameSession.CurrentEnemyTeam)
(Set GameSession.CurrentEnemyTeam) --> (Switch to BattleScreen)
(Switch to BattleScreen) --> (Battle result)
(Battle result) --> (Player won) : victory
(Battle result) --> (Player lost) : defeat
(Player won) --> (ExpService processes rewards)
(ExpService processes rewards) --> (Return to StoryScreen)
(Player lost) --> (Return to StoryScreen)
(Check team alive) --> (Return to StoryScreen) : all fainted
(Return to StoryScreen) --> Player

@enduml
