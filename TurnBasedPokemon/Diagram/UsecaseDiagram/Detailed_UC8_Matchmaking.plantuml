@startuml UC8_Matchmaking_UseCase
title UC8 - Join Matchmaking (Use Case Diagram)
skinparam linetype ortho
left to right direction

together {
  actor Player1
  actor Player2
}

rectangle "Matchmaking System" {
  (Select PvP from MainMenu)
  (PvPService.StartMatchmaking)
  (NetworkService connects to BattleHub)
  (BattleHub adds to MatchmakingService queue)
  (MatchmakingService searches for opponent)
  (Match found)
  (Keep searching)
  (Create BattleRoom)
  (Both players notified: MatchFound)
  (Switch to PvPScreen)
  (Cancel matchmaking)
  (Return to MainMenu)
}

Player1 --> (Select PvP from MainMenu)
Player2 --> (Select PvP from MainMenu)

(Select PvP from MainMenu) --> (PvPService.StartMatchmaking)
(PvPService.StartMatchmaking) --> (NetworkService connects to BattleHub)
(NetworkService connects to BattleHub) --> (BattleHub adds to MatchmakingService queue)
(BattleHub adds to MatchmakingService queue) --> (MatchmakingService searches for opponent) : <<invoke>>

(MatchmakingService searches for opponent) --> (Match found) : two players in queue
(MatchmakingService searches for opponent) --> (Keep searching) : waiting

(Match found) --> (Create BattleRoom) : <<include>>
(Create BattleRoom) --> (Both players notified: MatchFound)

(Both players notified: MatchFound) --> (Switch to PvPScreen)
(Switch to PvPScreen) --> Player1
(Switch to PvPScreen) --> Player2

(Keep searching) --> (Cancel matchmaking) : player cancels
(Cancel matchmaking) --> (Return to MainMenu)
(Return to MainMenu) --> Player1

@enduml

@enduml
