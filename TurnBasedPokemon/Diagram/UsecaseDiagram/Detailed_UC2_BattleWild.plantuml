@startuml UC2_BattleWild_UseCase
title UC2 - Battle Wild Pokemon (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor Player

rectangle "Wild Battle System" {
  (Explore in StoryScreen)
  (Random wild encounter)
  (WorldGenService spawns Pokemon)
  (Switch to BattleScreen)
  (Choose Action)
  (Select Move)
  (Switch Pokemon)
  (Attempt Catch)
  (Run from Battle)
  (BattleService calculates DamageResult)
  (Apply damage)
  (Check if Pokemon fainted)
  (Battle continues)
  (Battle Won)
  (Battle Lost)
  (ExpService.ProcessVictory)
}

Player --> (Explore in StoryScreen)
(Explore in StoryScreen) --> (Random wild encounter) : random spawn
(Random wild encounter) --> (WorldGenService spawns Pokemon)
(WorldGenService spawns Pokemon) --> (Switch to BattleScreen)
(Switch to BattleScreen) --> (Choose Action)

(Choose Action) --> (Select Move) : Move
(Choose Action) --> (Switch Pokemon) : Switch
(Choose Action) --> (Attempt Catch) : Catch
(Choose Action) --> (Run from Battle) : Run

(Select Move) --> (BattleService calculates DamageResult) : <<include>>
(BattleService calculates DamageResult) --> (Apply damage)
(Apply damage) --> (Check if Pokemon fainted)
(Check if Pokemon fainted) --> (Battle continues) : still fighting
(Check if Pokemon fainted) --> (Battle Won) : enemy defeated
(Check if Pokemon fainted) --> (Battle Lost) : player defeated

(Battle Won) --> (ExpService.ProcessVictory)
(ExpService.ProcessVictory) --> Player

(Run from Battle) --> Player : Escape
(Attempt Catch) --> Player : See UC3

@enduml
