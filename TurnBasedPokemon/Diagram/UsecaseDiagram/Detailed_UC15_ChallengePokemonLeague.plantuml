@startuml UC15_ChallengePokemonLeague_UseCase
title UC15 - Challenge Pokemon League (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor Player

rectangle "Pokemon League System" {
  (Select Pokemon League in StoryScreen)
  (Check Player.Badges count)
  (Has all badges?)
  (StoryService.TryChallengePokemonLeague)
  (PokemonSpawner generates boss team)
  (Switch to BattleScreen)
  (Battle Elite Four member)
  (Player won?)
  (Next Elite Four member)
  (All Elite Four beaten?)
  (Battle Champion)
  (AuthenService.SetChampion)
  (Player becomes Champion)
  (Return to StoryScreen)
  (Display not ready message)
}

Player --> (Select Pokemon League in StoryScreen)
(Select Pokemon League in StoryScreen) --> (Check Player.Badges count)
(Check Player.Badges count) --> (Has all badges?)
(Has all badges?) --> (StoryService.TryChallengePokemonLeague) : yes
(Has all badges?) --> (Display not ready message) : no

(StoryService.TryChallengePokemonLeague) --> (PokemonSpawner generates boss team)
(PokemonSpawner generates boss team) --> (Switch to BattleScreen)
(Switch to BattleScreen) --> (Battle Elite Four member)
(Battle Elite Four member) --> (Player won?)
(Player won?) --> (Next Elite Four member) : victory
(Player won?) --> (Return to StoryScreen) : defeat
(Next Elite Four member) --> (All Elite Four beaten?)
(All Elite Four beaten?) --> (Battle Champion) : all beaten
(All Elite Four beaten?) --> (StoryService.TryChallengePokemonLeague) : more members
(Battle Champion) --> (AuthenService.SetChampion) : victory
(AuthenService.SetChampion) --> (Player becomes Champion)
(Player becomes Champion) --> (Return to StoryScreen)
(Battle Champion) --> (Return to StoryScreen) : defeat
(Display not ready message) --> (Return to StoryScreen)
(Return to StoryScreen) --> Player

@enduml
