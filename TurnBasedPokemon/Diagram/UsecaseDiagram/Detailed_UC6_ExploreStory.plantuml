@startuml UC6_ExploreStory_UseCase
title UC6 - Explore Story (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor Player

rectangle "Story Mode System" {
  (Select Story from MainMenu)
  (Switch to StoryScreen)
  (StoryService loads story.json)
  (Display current location)
  (Choose action)
  (Explore next location)
  (Talk to NPC)
  (Challenge Gym)
  (Challenge Pokemon League)
  (Heal team at center)
  (Wild encounter)
  (Switch to BattleScreen)
  (NPC dialogue via HandleTalk)
  (StoryService.TryChallengeGym)
  (StoryService.TryChallengePokemonLeague)
  (StoryService.HealTeamAtCenter)
  (Return to MainMenu)
}

Player --> (Select Story from MainMenu)
(Select Story from MainMenu) --> (Switch to StoryScreen)
(Switch to StoryScreen) --> (StoryService loads story.json)
(StoryService loads story.json) --> (Display current location)
(Display current location) --> (Choose action)

(Choose action) --> (Explore next location)
(Choose action) --> (Talk to NPC)
(Choose action) --> (Challenge Gym)
(Choose action) --> (Challenge Pokemon League)
(Choose action) --> (Heal team at center)
(Choose action) --> (Return to MainMenu)

(Explore next location) --> (Wild encounter) : <<extend>>
(Wild encounter) --> (Switch to BattleScreen)
(Talk to NPC) --> (NPC dialogue via HandleTalk) : <<include>>
(Challenge Gym) --> (StoryService.TryChallengeGym) : <<include>>
(Challenge Pokemon League) --> (StoryService.TryChallengePokemonLeague) : <<include>>
(Heal team at center) --> (StoryService.HealTeamAtCenter) : <<include>>

(Switch to BattleScreen) --> Player
(NPC dialogue via HandleTalk) --> Player
(StoryService.TryChallengeGym) --> Player
(StoryService.TryChallengePokemonLeague) --> Player
(StoryService.HealTeamAtCenter) --> Player
(Return to MainMenu) --> Player

@enduml
