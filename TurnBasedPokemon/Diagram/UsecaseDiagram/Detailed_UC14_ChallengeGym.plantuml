@startuml UC14_ChallengeGym_UseCase
title UC14 - Challenge Gym Leader (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor Player

rectangle "Gym Challenge System" {
  (Select Challenge Gym in StoryScreen)
  (StoryService.TryChallengeGym)
  (Check team alive & progress)
  (Requirements met?)
  (PokemonSpawner generates Gym Leader team)
  (Set GameSession.CurrentEnemyTeam)
  (Switch to BattleScreen)
  (Battle Gym Leader)
  (Player won?)
  (Player.Badges updated)
  (ExpService processes rewards)
  (Display error message)
  (Return to StoryScreen)
}

Player --> (Select Challenge Gym in StoryScreen)
(Select Challenge Gym in StoryScreen) --> (StoryService.TryChallengeGym)
(StoryService.TryChallengeGym) --> (Check team alive & progress)
(Check team alive & progress) --> (Requirements met?)
(Requirements met?) --> (PokemonSpawner generates Gym Leader team) : yes
(Requirements met?) --> (Display error message) : no
(PokemonSpawner generates Gym Leader team) --> (Set GameSession.CurrentEnemyTeam)
(Set GameSession.CurrentEnemyTeam) --> (Switch to BattleScreen)
(Switch to BattleScreen) --> (Battle Gym Leader)
(Battle Gym Leader) --> (Player won?)
(Player won?) --> (Player.Badges updated) : victory
(Player.Badges updated) --> (ExpService processes rewards)
(ExpService processes rewards) --> (Return to StoryScreen)
(Player won?) --> (Return to StoryScreen) : defeat
(Display error message) --> (Return to StoryScreen)
(Return to StoryScreen) --> Player

@enduml
