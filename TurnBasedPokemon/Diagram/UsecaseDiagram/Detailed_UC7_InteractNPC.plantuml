@startuml UC7_InteractNPC_UseCase
title UC7 - Interact with NPC (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor Player

rectangle "NPC Interaction System" {
  (Approach NPC on map)
  (StoryScreen.HandleTalk)
  (Display NPC dialogue)
  (Check npc.Action)
  (Normal NPC)
  (Battle NPC)
  (Display dialogue text)
  (StoryService.TryChallengeTrainer)
  (PokemonSpawner generates team)
  (Switch to BattleScreen)
  (Return to StoryScreen)
}

Player --> (Approach NPC on map)
(Approach NPC on map) --> (StoryScreen.HandleTalk)
(StoryScreen.HandleTalk) --> (Display NPC dialogue)
(Display NPC dialogue) --> (Check npc.Action)

(Check npc.Action) --> (Normal NPC) : action == null
(Check npc.Action) --> (Battle NPC) : action == "StartBattle"

(Normal NPC) --> (Display dialogue text)
(Display dialogue text) --> (Return to StoryScreen)
(Return to StoryScreen) --> Player

(Battle NPC) --> (StoryService.TryChallengeTrainer) : <<include>>
(StoryService.TryChallengeTrainer) --> (PokemonSpawner generates team)
(PokemonSpawner generates team) --> (Switch to BattleScreen)
(Switch to BattleScreen) --> Player

@enduml
