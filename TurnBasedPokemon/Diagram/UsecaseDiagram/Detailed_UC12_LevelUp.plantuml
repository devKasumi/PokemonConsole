@startuml UC12_LevelUp_UseCase
title UC12 - Level Up / Evolve Pokemon (Use Case Diagram)
skinparam linetype ortho
left to right direction

actor Player

rectangle "Level Up & Evolution System" {
  (Battle won)
  (ExpService.ProcessVictory)
  (Calculate EXP gained)
  (Check level threshold)
  (Level up Pokemon)
  (Recalculate stats)
  (Check evolution condition)
  (WorldGenService evolves Pokemon)
  (Return ProcessExpResult)
  (BattleScreen displays summary)
}

Player --> (Battle won)
(Battle won) --> (ExpService.ProcessVictory)
(ExpService.ProcessVictory) --> (Calculate EXP gained)
(Calculate EXP gained) --> (Check level threshold)
(Check level threshold) --> (Level up Pokemon) : EXP >= threshold
(Level up Pokemon) --> (Recalculate stats)
(Recalculate stats) --> (Check evolution condition)
(Check evolution condition) --> (WorldGenService evolves Pokemon) : meets evolution level
(WorldGenService evolves Pokemon) --> (Return ProcessExpResult)
(Check evolution condition) --> (Return ProcessExpResult) : no evolution
(Check level threshold) --> (Return ProcessExpResult) : not enough EXP
(Return ProcessExpResult) --> (BattleScreen displays summary)
(BattleScreen displays summary) --> Player

@enduml
