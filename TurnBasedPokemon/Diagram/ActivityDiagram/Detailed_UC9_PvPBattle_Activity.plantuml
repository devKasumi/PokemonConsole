@startuml UC9_PvPBattle_Activity
start
:Both players connect to server and are matched in a battle room;
:Server (PvPManager) initializes battle state and notifies both clients;
:Display both teams on screen (client);

repeat
  :Player 1 selects move (client);
  :Player 2 selects move (client);
  :Both moves sent to server;
  if (Both moves received?) then (yes)
    :Server (PvPManager) determines turn order (speed stat);
    :Server applies attack damage, checks status, fainting, and updates state;
    :Server sends updated HP, party, and logs to both clients;
    :Clients display animations and update UI;
  else
    :Server waits or uses default action if timeout;
  endif
  if (Pokemon fainted?) then (yes)
    if (More Pokemon available?) then (yes)
      :Server prompts player to select next Pokemon;
      :Client sends selection to server;
      :Server updates active Pokemon;
    else (no)
      :Server declares winner and ends battle;
    endif
  endif
repeat while (Battle ongoing)

:Server determines winner & loser;
:Server awards EXP, calculates ELO, and records results;
:Server syncs results to database and notifies both clients;
stop
@enduml
