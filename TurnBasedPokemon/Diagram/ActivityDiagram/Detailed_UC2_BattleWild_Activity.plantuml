@startuml UC2_BattleWild_Activity
title UC2 - Battle Wild Pokemon (Activity Diagram)
start
:Player explores world in StoryScreen;
if (Random encounter triggered?) then (yes)
  :StoryService.ExploreWildArea() spawns via PokemonSpawner;
  :Set GameSession.CurrentEnemyPokemon;
  :ScreenManager switches to BattleScreen;
else (no)
  :Continue exploring;
  stop
endif

:BattleService initializes battle state;
:Determine turn order (speed stat);

repeat
  :BattleScreen displays options (Move/Switch/Catch/Run);
  :Player selects action;
  if (Action == Use Move?) then (yes)
    :Player selects move;
    :BattleService.ExecutePlayerTurn(moveIndex) calculates DamageResult;
    :Apply damage to enemy;
    :Display BattleTurnResult;
  elseif (Action == Switch Pokemon?) then (yes)
    :BattleService.CanSwitchPokemon(target);
    :Switch active Pokemon;
  elseif (Action == Run?) then (yes)
    if (Is trainer battle?) then (yes)
      :Display "You can not run, this is a trainer battle!";
    else (no)
      :GameSession.ClearBattle();
      :"Got away safely!" - escape from battle;
      stop
    endif
  endif
  
  if (Enemy Pokemon fainted?) then (yes)
    :BattleService.CheckNextOpponent();
    if (More enemy Pokemon?) then (yes)
      :Send next enemy Pokemon;
    else (no)
      :Battle Won!;
    endif
  endif
  
  :Enemy turn - BattleService selects AI move;
  :Apply DamageResult to player Pokemon;
  
  if (Player Pokemon fainted?) then (yes)
    if (More player Pokemon?) then (yes)
      :Prompt player to switch;
    else (no)
      :Battle Lost!;
      stop
    endif
  endif
repeat while (Battle ongoing?)

:ExpService.ProcessVictory() awards EXP;
:Display ProcessExpResult;
stop
@enduml
