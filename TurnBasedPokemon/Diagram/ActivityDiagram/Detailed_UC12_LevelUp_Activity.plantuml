@startuml UC12_LevelUp_Activity
title UC12 - Level Up (Activity Diagram)
start
:Battle won — BattleScreen calls ExpService.ProcessVictory();
:ExpService calculates EXP based on defeated Pokemon;

:ExpService checks each participating Pokemon;
if (Current EXP >= level threshold?) then (yes)
  :ExpService increments Pokemon.Level;
  :Recalculate stats based on new level;
  
  :Check evolution conditions;
  if (Level >= evolution level?) then (yes)
    :WorldGenService evolves Pokemon;
    :Update Pokemon name, stats, sprite;
    :Display "Pokemon evolved!";
  endif
  
  :Return ProcessExpResult;
  note
    ProcessExpResult contains:
    - ExpGained
    - LeveledUp (bool)
    - Evolved (bool)
    - New stats
  end note
  
  :BattleScreen displays level up summary;
  
else (no)
  :Add EXP to Pokemon;
  :Return ProcessExpResult (no level up);
endif

stop
@enduml
