@startuml UC8_Matchmaking_Activity
title UC8 - Matchmaking (Activity Diagram)
start
:Player selects "PvP" from MainMenuScreen;
:MainMenuScreen calls PvPService.StartMatchmaking();
:PvPService calls NetworkService.ConnectAsync();

if (Connection to BattleHub successful?) then (yes)
  :NetworkService sends JoinMatchmaking(player data);
  :BattleHub adds player to MatchmakingService queue;
  :Display "Searching for opponent...";
  
  repeat
    :MatchmakingService checks queue;
    
    if (Two players in queue?) then (yes)
      :MatchmakingService creates BattleRoom;
      :BattleHub notifies both clients: MatchFound;
      :PvPService receives opponent info;
      :ScreenManager switches to PvPScreen;
    endif
    
    if (Player cancelled?) then (yes)
      :NetworkService sends LeaveMatchmaking;
      :Return to MainMenuScreen;
      stop
    endif
  repeat while (Searching for opponent)
  
else (no)
  :Display "Cannot connect to server";
  :Return to MainMenuScreen;
  stop
endif

stop
@enduml
