@startuml UC18_Register_Activity
title UC18 - Register (Activity Diagram)
start
:Player selects "Register" on LoginScreen;
:LoginScreen displays registration form;

:Player enters username;
:Player enters password;
:Player confirms password;

:LoginScreen calls AuthenService.Register(RegisterRequest);
:AuthenService checks UserRepository for existing username;

if (Username available?) then (yes)
  :AuthenService creates new User in users.json;
  :AuthenService initializes empty Player;
  :AuthenService sets GameSession.Player;
  :Display "Account created!";
  :ScreenManager switches to StoryScreen (starter selection);
else (no)
  :Display "Username already taken";
  :Return to registration form;
endif

stop
@enduml
