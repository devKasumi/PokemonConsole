@startuml UC14_ChallengeGym_Activity
start
:Player enters Gym;
:Gym Leader intro dialogue;

:Check requirements:;
note
  - Player level >= Min level
  - Player has required Pokemon
  - Player not just beat this gym
  - Story milestone reached
end note

if (Requirements met?) then (yes)
  :Load Gym Leader team from database;
  :Display trainer battle UI;
  :Player vs Gym Leader Battle;
  note right
    Execute UC_2 variant: Battle Story Trainer
    Gym Leader battles have:
    - Gimmick (weather, terrain)
    - Themed Pokemon
    - Mega Evolution possible
  end note
  
  if (Player won?) then (yes)
    :Play victory music;
    :Display "You defeated [Gym Leader]!";
    :Receive Badge;
    note
      - Badge sprite
      - Badge name
      - Badge data stored
    end note
    
    :Deduct from Gym Leader pool;
    :Receive TM or held item;
    
    :Update story progress;
    :Mark gym as completed;
    :Unlock next gym location;
    
  else (no)
    :Play defeat music;
  endif
  
else (no)
  :Gym Leader says "Come back stronger";
  :Return to story;
endif

stop
@enduml
