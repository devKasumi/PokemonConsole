@startuml UC1_Login_Activity
title UC1 - Login (Activity Diagram)
start
:Player launches game;
:LoginScreen displayed;
:Player enters username & password;
:LoginScreen calls AuthenService.Login(LoginRequest);

if (User found in JSON repository?) then (yes)
  if (Password correct?) then (yes)
    :AuthenService loads Player, PokemonTeam, Inventory;
    :AuthenService sets GameSession.Player;
    :ScreenManager switches to MainMenuScreen;
    stop
  else (no)
    :Display "Incorrect Password" error;
    :Return to LoginScreen;
    stop
  endif
else (no)
  :Display "User not found" error;
  :Return to LoginScreen;
  stop
endif
@enduml
