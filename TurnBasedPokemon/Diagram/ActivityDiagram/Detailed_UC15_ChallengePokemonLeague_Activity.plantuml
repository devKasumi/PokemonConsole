@startuml UC15_ChallengePokemonLeague_Activity
start
:Player enters Pokemon League;
:Check if has all 8 badges;

if (Has all 8 badges?) then (yes)
  repeat
    :Display their team;
    :Player vs Elite Four Battle;
    
    if (Player won?) then (yes)
      :Continue to next member;
    else (no)
      :Black out - return to Pokemon Center;
      stop
    endif
  repeat while (More Elite Four members)
  
  :Meet Champion;
  :Champion intro dialogue;
  :Display Champion team (usually strong);
  
  :Final battle: Player vs Champion;
  if (Player won?) then (yes)
    :Play victory theme;
    :Champion concedes defeat;
    :Player enters Hall of Fame;
    note
      Hall of Fame entry includes:
      - Player name
      - Date defeated
      - Team composition
      - Time played
    end note
    
    :Receive Champion title;
    :Receive massive prize money;
    :Unlock post-game content;
    
  else (no)
    :Defeat screen;
    :Return to Pokemon Center;
    :Can retry after healing;
  endif
  
else (no)
  :Guard blocks:;
  :"You must earn all 8 badges first!";
endif

stop
@enduml
