@startuml
title Game State Diagram

[*] --> LoginScreen

state LoginScreen {
  [*] --> WaitingForInput
  WaitingForInput --> Authenticating : Submit credentials
  Authenticating --> WaitingForInput : Login failed
}

LoginScreen --> MainMenu : Login successful

state MainMenu {
  [*] --> Idle
  Idle --> StoryScreen : Select "Story"
  Idle --> PvPMatchmaking : Select "PvP"
  Idle --> Idle : Save / Load
}

state StoryScreen {
  [*] --> Exploring
  Exploring --> BattleScreen : Wild encounter
  Exploring --> BattleScreen : Challenge Gym / Trainer / League
  Exploring --> Exploring : Heal team / Talk NPC
}

state BattleScreen {
  [*] --> CombatLoop
  CombatLoop --> Victory : Enemy Fainted
  CombatLoop --> Defeat : Player Fainted
  CombatLoop --> StoryScreen : Run Away (Wild Only)
}

Victory --> StoryScreen : Gain EXP / Unlock Badge
Defeat --> StoryScreen : Return to safety

state PvPMatchmaking {
  [*] --> SearchingOpponent
  SearchingOpponent --> PvPScreen : Match found
  SearchingOpponent --> MainMenu : Cancel
}

state PvPScreen {
  [*] --> PvPCombat
  PvPCombat --> PvPResult : Battle ended
}

PvPResult --> MainMenu : Return to menu

@enduml