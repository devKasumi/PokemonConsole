@startuml UC4_UseItems_Sequence
participant Player
participant InventoryScreen
participant ICatchService as CatchService
participant IHealingService as HealingService
participant GameSession

Player -> InventoryScreen: Open Inventory (from BattleScreen)
activate InventoryScreen

InventoryScreen -> InventoryScreen: RenderText() - display item pockets
InventoryScreen --> Player: Show item categories (Healing, Capture, General)

Player -> InventoryScreen: Select pocket category
InventoryScreen -> InventoryScreen: OpenPocket(ItemCategory)

alt Item Category = Healing
  InventoryScreen --> Player: Show healing items list
  Player -> InventoryScreen: Select healing item

  InventoryScreen -> HealingService: ExecuteHealing(healingItem)
  activate HealingService
  HealingService -> GameSession: Get Player.CurrentPokemon
  HealingService -> HealingService: Restore HP (min of healAmount, maxHp - currentHp)
  HealingService -> GameSession: Player.RemoveItem(item)
  HealingService --> InventoryScreen: true (success)
  deactivate HealingService

  InventoryScreen --> Player: Show "Pokemon HP restored!"

else Item Category = Capture
  alt In Battle (wild Pokemon)
    InventoryScreen --> Player: Show available Pokeballs
    Player -> InventoryScreen: Select ball type

    InventoryScreen -> CatchService: ExecuteCapture(captureItem, enemyPokemon)
    activate CatchService
    CatchService --> InventoryScreen: CatchResult(IsCaught, Shakes, DisplayMessage)
    deactivate CatchService

    InventoryScreen --> Player: Show catch result
  else Not in wild battle
    InventoryScreen --> Player: "Cannot use here"
  end

else Item Category = General
  InventoryScreen --> Player: Show general items (info only)
end

deactivate InventoryScreen
@enduml
