@startuml Pokemon Login Flow

actor User

participant Program
participant AuthService
participant PlayerRepository
participant Utility
participant ScreenManager

User -> Program : Enter Username/Password
Program -> AuthService : Authenticate(username, password)

AuthService -> PlayerRepository : LoadUser(username)
PlayerRepository --> AuthService : Return User Data

AuthService -> Utility : VerifyPassword(hash, input)
Utility --> AuthService : true/false

alt Success
    AuthService --> Program : Return User object
    Program -> ScreenManager : GoToStoryScreen(User)
else Fail
    AuthService --> Program : Authentication Failed
end

@enduml