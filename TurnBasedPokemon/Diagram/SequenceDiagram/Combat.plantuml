@startuml
actor Player
participant BattleScreen
participant DamageCalculator
participant "Enemy : Pokemon" as Enemy

Player -> BattleScreen : Select Move (Input Index)
activate BattleScreen

BattleScreen -> BattleScreen : Get move from activePoke.Moves[index-1]
note right: Fix: Indexing corrected to avoid offset errors

BattleScreen -> DamageCalculator : CalculateDamage(player, enemy, move)
activate DamageCalculator
DamageCalculator -> DamageCalculator : Math.Max(1, enemy.Defense)
note right: Fix: Prevented DivideByZeroException
return damageValue

BattleScreen -> Enemy : TakeDamage(damageValue)
activate Enemy
Enemy -> Enemy : currentHP -= damageValue
return Updated HP

BattleScreen -> Player : Render UI (HP Bar update)
deactivate BattleScreen
@endum