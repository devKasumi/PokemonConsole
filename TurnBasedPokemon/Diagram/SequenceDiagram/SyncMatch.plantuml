@startuml        
title Sd_PvP: Sync Match Results to Database

actor "Player" as P
participant "BattleScreen" as UI
participant "ExpCalculator" as Rules
participant "Player" as Entity
participant "repo:PlayerRepository" as DAL
database "user.json" as DB

P -> UI : View Battle Results
activate UI

UI -> Rules : CalculateExpGain(isTrainerBattle=true, ...)
activate Rules
Rules --> UI : expGain
deactivate Rules

UI -> Entity : GainExperience(expGain)
activate Entity
loop Level Up Loop
    Entity -> Rules : CanLevelUp(level, currentExp)
    Rules --> Entity : true/false
    Entity -> Entity : LevelUp() (Cập nhật Stats)
end
Entity --> UI : Updated Player Data
deactivate Entity

UI -> DAL : Save(playerData)
activate DAL
DAL -> DAL : JsonSerializer.Serialize()
DAL -> DB : Write updated playerData to user.json
DB --> DAL : Success
DAL --> UI : Save Completed
deactivate DAL

UI --> P : Display Updated Player Info
deactivate UI

@enduml