@startuml UC3_CatchPokemon_Sequence
participant Player
participant InventoryScreen
participant ICatchService as CatchService
participant CatchFormula
participant GameSession

Player -> InventoryScreen: Select Capture item during battle
activate InventoryScreen

InventoryScreen -> InventoryScreen: OpenPocket(ItemCategory.Capture)

alt Has Pokeballs
  InventoryScreen --> Player: Show ball selection
  Player -> InventoryScreen: Select Pokeball type

  InventoryScreen -> CatchService: ExecuteCapture(captureItem, wildPokemon)
  activate CatchService

  CatchService -> CatchFormula: AttemptCatch(target, ball)
  activate CatchFormula

  note over CatchFormula
    Calculate based on:
    - Pokemon HP ratio (currentHP / maxHP)
    - Ball CatchRateMultiplier
    - Master Ball = instant catch
    - Random shake checks (1-3)
  end note

  CatchFormula --> CatchService: CatchResult(IsCaught, Shakes, DisplayMessage)
  deactivate CatchFormula

  alt IsCaught = true
    CatchService -> GameSession: Player.PokemonTeam.Add(pokemon)
    CatchService --> InventoryScreen: CatchResult.Success
    deactivate CatchService
    InventoryScreen --> Player: Show shake animation + "Pokemon caught!"

  else IsCaught = false
    CatchService -> GameSession: Player.RemoveItem(ball)
    CatchService --> InventoryScreen: CatchResult.Failure
    deactivate CatchService
    InventoryScreen --> Player: Show shakes + "Pokemon broke free!"
  end

else No Pokeballs
  InventoryScreen --> Player: "No capture items available"
end

deactivate InventoryScreen
@enduml
