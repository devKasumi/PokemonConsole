@startuml UC16_ChallengeTrainer_Sequence
title UC16 - Challenge Trainer (Sequence Diagram)
note over Player
  **Under Development** — Trainer challenge logic
  exists via StoryService.TryChallengeTrainer(),
  but dedicated Trainer screen is not yet implemented.
end note

participant "Player" as Player
participant "StoryScreen" as Screen
participant "IStoryService\n(StoryService)" as StoryService
participant "PokemonSpawner" as Spawner
participant "GameSession" as GS
participant "ScreenManager" as SM

Player -> Screen: Encounter Trainer NPC
activate Screen

Screen -> Screen: HandleTalk(npc)
Screen --> Player: Display trainer dialogue

note over Screen: npc.Action == "StartBattle"

Screen -> StoryService: TryChallengeTrainer(npc)
activate StoryService

StoryService -> GS: Check Player.PokemonTeam alive
activate GS
GS --> StoryService: team status
deactivate GS

alt Team has alive Pokemon
  StoryService -> Spawner: SpawnPokemon(trainer pokemon config)
  activate Spawner
  Spawner --> StoryService: List<Pokemon> enemyTeam
  deactivate Spawner
  
  StoryService -> GS: Set CurrentEnemyTeam = enemyTeam
  StoryService -> GS: Set IsTrainerBattle = true
  StoryService --> Screen: (true, "Trainer battle!", enemyTeam)
  deactivate StoryService
  
  Screen -> SM: SwitchScreen(ScreenType.BATTLE)
  note over SM
    Battle executes per UC2 flow.
    BattleService handles turn logic.
    On victory: ExpService processes exp/level up.
  end note
  
else All Pokemon fainted
  StoryService --> Screen: (false, "No alive Pokemon", null)
  deactivate StoryService
  Screen --> Player: "Heal your Pokemon first!"
end

deactivate Screen
@enduml
