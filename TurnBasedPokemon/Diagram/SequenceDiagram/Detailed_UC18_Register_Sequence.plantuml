@startuml UC18_Register_Sequence
participant NewPlayer
participant LoginScreen
participant IAuthenService as AuthenService
participant IUserRepository as UserRepository
participant GameSession

NewPlayer -> LoginScreen: Select "Register"
activate LoginScreen

LoginScreen --> NewPlayer: Prompt for username and password

NewPlayer -> LoginScreen: Enter username & password

LoginScreen -> AuthenService: Register(RegisterRequest(username, password))
activate AuthenService

AuthenService -> UserRepository: GetByUsername(username)
activate UserRepository
UserRepository --> AuthenService: User? (null if available)
deactivate UserRepository

alt Username available
  AuthenService -> AuthenService: Create new User(username, password)
  AuthenService -> UserRepository: Save(newUser)
  activate UserRepository
  UserRepository -> UserRepository: Serialize to JSON
  UserRepository -> UserRepository: Write to users.json
  UserRepository --> AuthenService: User saved
  deactivate UserRepository

  AuthenService -> GameSession: CurrentUser = newUser
  AuthenService --> LoginScreen: true (registration success)
  deactivate AuthenService

  LoginScreen --> NewPlayer: "Registration successful! Switching to main menu..."
  LoginScreen -> LoginScreen: SwitchTo(MainMenu)

else Username already taken
  AuthenService --> LoginScreen: false (registration failed)
  deactivate AuthenService
  LoginScreen --> NewPlayer: "Username already exists, try another"
end

deactivate LoginScreen
@enduml
