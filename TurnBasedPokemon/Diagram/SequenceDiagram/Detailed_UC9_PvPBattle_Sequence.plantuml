@startuml UC9_PvPBattle_Sequence
participant Player
participant PvPScreen
participant INetworkService as NetworkService
participant BattleHub
participant PvPManager
participant DamageCalculator
participant Opponent

note over PvPScreen
  PvPScreen receives roomId via
  Initialize(data: { RoomId })
  from MainMenuScreen after matchmaking
end note

PvPScreen -> PvPScreen: Initialize(roomId)
PvPScreen -> NetworkService: Subscribe OnTurnResultReceived

loop Battle Active
  PvPScreen -> PvPScreen: RenderBattleScene(lastResult)
  PvPScreen -> PvPScreen: ShowMoveMenu(myActive)
  Player -> PvPScreen: Select move (1-4)
  activate PvPScreen

  PvPScreen -> PvPScreen: Validate move index (loop until valid)

  PvPScreen -> NetworkService: SubmitMoveAsync(roomId, playerName, moveIndex, attackerPokemon)
  activate NetworkService
  NetworkService -> BattleHub: SubmitMove(BattleActionRequest)
  activate BattleHub

  BattleHub -> PvPManager: RegisterMove(request)
  activate PvPManager

  note over PvPManager
    Both players' moves must be
    registered before processing
  end note

  Opponent -> BattleHub: SubmitMove(BattleActionRequest)
  BattleHub -> PvPManager: RegisterMove(opponentRequest)

  alt Both moves received
    PvPManager -> PvPManager: Determine turn order (Speed)
    PvPManager -> DamageCalculator: Calculate(attacker, defender, move)
    activate DamageCalculator
    DamageCalculator -> DamageCalculator: TypeChart.GetMultiplier()
    DamageCalculator --> PvPManager: DamageResult(damage, isCritical, typeMultiplier)
    deactivate DamageCalculator
    PvPManager -> PvPManager: Apply damage, check fainted
    PvPManager --> BattleHub: PvPTurnResult(playerState, opponentState, logs, winner?)
    deactivate PvPManager
    BattleHub -> NetworkService: TurnResultReceived(PvPTurnResult)
    deactivate BattleHub
    NetworkService -> PvPScreen: OnTurnResultReceived event
    deactivate NetworkService
    PvPScreen -> PvPScreen: Cache result in _lastResult (volatile)
  else Waiting for opponent
    PvPScreen --> Player: "Waiting for opponent..."
    PvPScreen -> PvPScreen: Thread.Sleep(200) polling loop
  end

  deactivate PvPScreen

  alt Winner determined
    PvPScreen --> Player: Display winner + battle summary
    PvPScreen -> PvPScreen: SwitchTo(MainMenu)
  end
end

@enduml
