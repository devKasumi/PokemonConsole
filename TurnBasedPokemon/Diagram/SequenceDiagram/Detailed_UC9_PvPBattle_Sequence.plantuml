@startuml UC9_PvPBattle_Sequence
participant Player1
participant HubConnection
participant BattleHub
participant PvPManager
participant DamageCalculator
participant Player2
participant Database

Player1 -> HubConnection: FindMatch(username)
HubConnection -> BattleHub: FindMatch(username)
BattleHub -> PvPManager: InitializeBattle(roomId, player1, team1, player2, team2)
BattleHub -> Player1: MatchFound(roomId, opponent)
BattleHub -> Player2: MatchFound(roomId, opponent)

loop while (Battle active)
  activate BattleHub
  
  PvPBattle1 -> HubConnection: SubmitMove(roomId, moveIndex)

  loop while (Battle active)
    Player1 -> HubConnection: SubmitMove(roomId, moveIndex)
    Player2 -> HubConnection: SubmitMove(roomId, moveIndex)
    HubConnection -> BattleHub: SubmitMove(request)
    HubConnection -> BattleHub: SubmitMove(request)
    BattleHub -> PvPManager: RegisterMove(request)
    BattleHub -> PvPManager: RegisterMove(request)
    alt Both moves received
      BattleHub -> PvPManager: ProcessTurn(roomId)
      PvPManager -> DamageCalculator: CalculateDamage(attacker, defender, move)
      DamageCalculator --> PvPManager: Damage value
      PvPManager --> BattleHub: PvPTurnResult (HP, logs, winner)
      BattleHub -> Player1: ReceiveTurnResult(result)
      BattleHub -> Player2: ReceiveTurnResult(result)
    else Waiting for moves
      BattleHub -> Player1: WaitingForOpponentMove
      BattleHub -> Player2: WaitingForOpponentMove
    end
  end
deactivate PvPBattle2
BattleHub -> Database: RecordMatch(roomId, winner, loser, eloChanges, timestamp)
Database --> BattleHub: Match recorded
BattleHub -> Player1: BattleEnd(yourResult, eloChange, rewards)
BattleHub -> Player2: BattleEnd(yourResult, eloChange, rewards)
@enduml
