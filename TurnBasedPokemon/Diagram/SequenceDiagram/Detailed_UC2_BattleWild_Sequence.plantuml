@startuml UC2_BattleWild_Sequence
participant Player
participant BattleScreen
participant IBattleService as BattleService
participant DamageCalculator
participant GameSession

Player -> BattleScreen: Wild encounter triggered (from StoryScreen)
activate BattleScreen

BattleScreen -> BattleScreen: Initialize - read enemy from GameSession
BattleScreen --> Player: Display battle screen

loop Battle ongoing
  Player -> BattleScreen: Select action (Fight/Bag/Switch/Run)
  activate BattleScreen

  alt Action = Fight
    BattleScreen -> BattleScreen: ShowMoveMenu()
    Player -> BattleScreen: Select move (1-4)
    BattleScreen -> BattleService: ExecutePlayerTurn(moveIndex)
    activate BattleService
    BattleService -> DamageCalculator: Calculate(attacker, defender, move)
    activate DamageCalculator
    DamageCalculator --> BattleService: DamageResult(damage, isCritical, typeMultiplier)
    deactivate DamageCalculator
    BattleService -> BattleService: Apply damage to enemy
    BattleService --> BattleScreen: BattleTurnResult(combatLogs, isEnemyFainted)
    deactivate BattleService

    alt Enemy not fainted
      BattleScreen -> BattleService: ExecuteEnemyTurn()
      activate BattleService
      BattleService -> BattleService: Select random move
      BattleService -> DamageCalculator: Calculate(enemy, player, move)
      DamageCalculator --> BattleService: DamageResult
      BattleService --> BattleScreen: BattleTurnResult(combatLogs, isPlayerFainted)
      deactivate BattleService
    end

  else Action = Open Bag
    BattleScreen -> BattleScreen: SwitchTo(Inventory)
    note over BattleScreen: Go to UC4: Use Items

  else Action = Switch Pokemon
    BattleScreen -> BattleService: CanSwitchPokemon(target)
    BattleService --> BattleScreen: bool
    BattleScreen -> GameSession: Update CurrentPokemon

  else Action = Run
    BattleScreen -> BattleScreen: 50% escape chance
    alt Escape successful
      BattleScreen --> Player: "Got away safely!"
      BattleScreen -> BattleScreen: SwitchTo(Story)
      break
    else Escape failed
      BattleScreen --> Player: "Can't escape!"
    end
  end

  deactivate BattleScreen
end

alt Battle Won (enemy fainted)
  BattleScreen -> BattleService: ProcessVictory()
  activate BattleService
  BattleService --> BattleScreen: ProcessExpResult(expGained, leveledUp, evolutionName, newMoves)
  deactivate BattleService

  BattleScreen --> Player: Show victory + EXP + level up + evolution
  BattleScreen -> BattleScreen: CheckNextOpponent()
  alt More enemies (trainer battle)
    BattleScreen -> GameSession: MoveToNextEnemy()
  else No more enemies
    BattleScreen -> BattleScreen: SwitchTo(Story)
  end

else Battle Lost (player fainted)
  BattleScreen --> Player: Show defeat screen
  BattleScreen -> BattleScreen: SwitchTo(Story)
end

deactivate BattleScreen
@enduml
