@startuml UC6_ExploreStory_Sequence
participant Player
participant StoryScreen
participant IStoryService as StoryService
participant IStoryRepository as StoryRepository
participant IAuthenService as AuthenService
participant GameSession

Player -> StoryScreen: Enter Story Mode
activate StoryScreen

StoryScreen -> StoryService: InitializeStory(command)
activate StoryService
StoryService -> GameSession: Get Player.CurrentPhase

note over StoryService
  StoryService loads story data from
  IStoryRepository (injected in constructor).
  Data is cached in _gameData field.
end note

StoryService -> StoryRepository: LoadStoryData()
StoryRepository --> StoryService: GameData (phases, locations, NPCs)
StoryService -> GameSession: Set CurrentLocation
StoryService --> StoryScreen: Story initialized
deactivate StoryService

alt ShouldPlayNarrative()
  StoryScreen -> StoryScreen: DisplayNarrative()
  StoryScreen -> StoryService: MarkNarrativeAsPlayed()
end

StoryScreen --> Player: Display story location screen

loop while (In story)
  Player -> StoryScreen: Select action

  alt Action = Move Forward/Back
    StoryScreen -> StoryService: Move(forward: bool)
    activate StoryService
    StoryService -> GameSession: Update CurrentLocation
    StoryService --> StoryScreen: Location description message
    deactivate StoryService
    StoryScreen --> Player: Display new location

  else Action = Explore Wild Area
    StoryScreen -> StoryService: ExploreWildArea()
    activate StoryService
    alt Wild Pokemon encounter
      StoryService --> StoryScreen: (true, message, wildPokemon, null)
      deactivate StoryService
      StoryScreen -> StoryScreen: SetupBattle + SwitchTo(Battle)
      note over StoryScreen: Go to UC2: Battle Wild Pokemon
    else Found Item
      StoryService --> StoryScreen: (true, message, null, foundItem)
      StoryScreen --> Player: Display "Found {item}!"
    else Nothing found
      StoryService --> StoryScreen: (false, message, null, null)
      StoryScreen --> Player: Display exploration message
    end

  else Action = Talk to NPC
    StoryScreen -> StoryScreen: HandleTalk(npc)
    StoryScreen --> Player: Show NPC dialogue
    alt NPC is Gym Leader
      StoryScreen -> StoryScreen: HandleGymBattle()
      note over StoryScreen: Go to UC14: Challenge Gym
    else NPC is Elite Four / Champion
      StoryScreen -> StoryScreen: HandlePokemonLeagueBattle()
      note over StoryScreen: Go to UC15: Challenge Pokemon League
    else NPC is Trainer
      note over StoryScreen: Go to UC16: Challenge Trainer
    end

  else Action = Heal Team
    StoryScreen -> StoryService: HealTeamAtCenter()
    activate StoryService
    StoryService -> GameSession: Restore all Pokemon HP
    StoryService --> StoryScreen: Heal result message
    deactivate StoryService
    StoryScreen --> Player: Display "Team healed!"

  else Action = Give Starter
    StoryScreen -> StoryService: GiveStarter(starterName)
    activate StoryService
    StoryService -> GameSession: Add starter to team
    StoryService --> StoryScreen: (success, message)
    deactivate StoryService
    StoryScreen --> Player: Display starter received

  else Action = Save (via Champion)
    StoryScreen -> AuthenService: SetChampion()
    activate AuthenService
    AuthenService -> GameSession: Player.IsChampion = true
    AuthenService --> StoryScreen: Champion set
    deactivate AuthenService
  end
end

deactivate StoryScreen
@enduml
